@code
{
    static string GetSkillGridStyle()
    {
        return "display: grid; grid-auto-flow: column; column-gap: 12px; grid-template-rows: repeat(3, minmax(0, 1fr));";
    }

    static string GetTextLinkStyle()
    {
        return "text-decoration: underline;";
    }

    static string GetHeaderLinkIconStyle()
    {
        return "color: #7777EE;";
    }

    static string GetHeaderLinkAnchorTextStyle()
    {
        return "text-decoration: underline; color: #5555EE;";
    }
}
