@code
{
    static string GetSkillGridStyle()
    {
        return "display: grid; grid-auto-flow: column; column-gap: 12px; grid-template-rows: repeat(3, minmax(0, 1fr));";
    }

    static string GetInlineIconStyle()
    {
        return "padding: 0; height: 0; overflow: visible; color: color-mix(in srgb, var(--mud-palette-primary) 50%, var(--mud-palette-text-primary) 25%);";
    }

    static string GetInlineIconSpacerWidth()
    {
        return "0.1em";
    }
}
