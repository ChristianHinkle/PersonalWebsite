<div>
    <div style="position: relative; display: inline-block; width: 100%;">
        <div class="ch-resume-item-line" style="position: absolute; width: 100%; height: 80%; top: 10%;"></div>
        <div class="mud-width-full d-flex flex-row justify-space-between" style="position: relative;">
            @Title
            @Date
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public RenderFragment Title { get; set; }

    [Parameter]
    public RenderFragment Date { get; set; }
}
