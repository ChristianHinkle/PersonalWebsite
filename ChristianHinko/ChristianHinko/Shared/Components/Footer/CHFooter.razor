<div class="d-flex flex-column gap-8 py-4">
    <!-- External hyperlinks -->
    <MudGrid Class="mud-width-full" Justify="@Justify.Center" Spacing="0">
        <MudItem Class="@("ma-0 pa-0 " + HyperlinkIconButtonsWrapperClass)" md="6" sm="12">
            <CHHyperlinkIconButton Name="GitHub" Icon="@Icons.Custom.Brands.GitHub" Href="@Classes.SocialMedia.GitHubProfileUrl" />
            <CHHyperlinkIconButton Name="LinkedIn" Icon="@Icons.Custom.Brands.LinkedIn" Href="@Classes.SocialMedia.LinkedInProfileUrl" />
            <CHHyperlinkIconButton Name="Twitter" Icon="@Icons.Custom.Brands.Twitter" Href="@Classes.SocialMedia.TwitterProfileUrl" />
            <CHHyperlinkIconButton Name="Instagram" Icon="@Icons.Custom.Brands.Instagram" Href="@Classes.SocialMedia.InstagramProfileUrl" />
            <CHHyperlinkIconButton Name="Facebook" Icon="@Icons.Custom.Brands.Facebook" Href="@Classes.SocialMedia.FacebookProfileUrl" />
            <CHHyperlinkIconButton Name="YouTube" Icon="@Icons.Custom.Brands.YouTube" Href="@Classes.SocialMedia.YouTubeProfileUrl" />
            <CHHyperlinkIconButton Name="Twitch" Icon="@MBELIcons.Brands.Twitch" Href="@Classes.SocialMedia.TwitchProfileUrl" />
        </MudItem>
        <MudItem Class="@("ma-0 pa-0 " + HyperlinkIconButtonsWrapperClass)" md="6" sm="12">
            <CHHyperlinkIconButton Name="TikTok" Icon="@Icons.Custom.Brands.TikTok" Href="@Classes.SocialMedia.TikTokProfileUrl" />
            <CHHyperlinkIconButton Name="ArtStation" Icon="@MBELIcons.Brands.ArtStation" Href="@Classes.SocialMedia.ArtStationProfileUrl" />
            <CHHyperlinkIconButton Name="DeviantArt" Icon="@MBELIcons.Brands.DeviantArt" Href="@Classes.SocialMedia.DeviantArtProfileUrl" />
            <CHHyperlinkIconButton Name="Pixiv" Icon="@MBELIcons.Brands.Pixiv" Href="@Classes.SocialMedia.PixivProfileUrl" />
            <CHHyperlinkIconButton Name="Reddit" Icon="@Icons.Custom.Brands.Reddit" Href="@Classes.SocialMedia.RedditProfileUrl" />
            <CHHyperlinkIconButton Name="Pinterest" Icon="@Icons.Custom.Brands.Pinterest" Href="@Classes.SocialMedia.PinterestProfileUrl" />
            <CHHyperlinkIconButton Name="Tumblr" Icon="@MBELIcons.Brands.Tumblr" Href="@Classes.SocialMedia.TumblrProfileUrl" />
        </MudItem>
    </MudGrid>
    <!-- Copyright notice -->
    <MudText Typo="@Typo.body1" Align="@Align.Center">
        Copyright © 2023-2026 Christian Hinkle.
    </MudText>
</div>

@code
{
    private string HyperlinkIconButtonsWrapperClass = "d-flex flex-row justify-space-around";
}
